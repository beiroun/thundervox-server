# thundervox-server - secrets for the local Docker Compose stack (docker-compose.yml)
# Copy to .env (gitignored) and fill every value; compose refuses to start while one is empty.
# Postgres takes TVX_DB_PASSWORD only when ./.local is created: after changing it, `rm -rf .local`.

# Schema owner `thundervox`: openssl rand -hex 16
TVX_DB_PASSWORD=
# Role `tvx_sip` the core logs in with (created by migration V3): openssl rand -hex 16
TVX_SIP_DB_PASSWORD=
# Console token signing key, at least 32 characters: openssl rand -hex 32
TVX_JWT_SECRET=
# Super administrator password (login TVX_SUPERADMIN_LOGIN, admin by default), at least 12 characters
TVX_SUPERADMIN_PASSWORD=
# X-CORE-TOKEN of the internal API, at least 32 characters: openssl rand -hex 32
TVX_CORE_TOKEN=
